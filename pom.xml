<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.2</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.example</groupId>
	<artifactId>spring-security-qr-login-demo</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>Spring Security QR Login Demo</name>
	<description>A runnable self-hosted QR code login demo using Spring Boot and Spring Security.</description>
	<url>https://github.com/zhijunio/spring-security-qr-login-demo</url>
	<scm>
		<connection>scm:git:https://github.com/zhijunio/spring-security-qr-login-demo.git</connection>
		<developerConnection>scm:git:ssh://git@github.com/zhijunio/spring-security-qr-login-demo.git</developerConnection>
		<tag>HEAD</tag>
		<url>https://github.com/zhijunio/spring-security-qr-login-demo</url>
	</scm>
	<properties>
		<java.version>25</java.version>
	</properties>
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<dependency>
			<groupId>com.google.zxing</groupId>
			<artifactId>javase</artifactId>
			<version>3.5.4</version>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
					<plugin>
				<groupId>com.diffplug.spotless</groupId>
				<artifactId>spotless-maven-plugin</artifactId>
				<version>3.10.4</version>
				<configuration>
					<java>
						<importOrder/>
						<removeUnusedImports/>
						<formatAnnotations/>
						<palantirJavaFormat>
							<version>2.102.0</version>
						</palantirJavaFormat>
					</java>
				</configuration>
				<executions>
					<execution>
						<goals><goal>check</goal></goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
